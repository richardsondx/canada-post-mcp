# Canada Post MCP - local environment example
# Copy to .env and fill in your own values. Never commit a real .env file.
# No values below are real. Leave blank to use public (unauthenticated) routes only.

# Developer Portal OAuth credentials (preferred route, used first).
# Create a Test app in the Canada Post Developer Portal, subscribe it to
# Tracking and Rating, then copy its API Key and API Secret here.
# Token: POST /prod/devportal-portaildesdeveloppeurs/cpc-api-native-oauth-provider/oauth2/token
# grant_type=client_credentials, scope=merchant, Basic auth with Key:Secret.
CANADA_POST_DEVPORTAL_KEY=
CANADA_POST_DEVPORTAL_SECRET=
CANADA_POST_CUSTOMER_NUMBER=
CANADA_POST_CONTRACT_NUMBER=

# Official Canada Post Developer Program credentials (free developer key).
# Get them at https://www.canadapost-postescanada.ca/info/mc/business/productsservices/developers/services/gettingstarted.jsf
# Used only for the authenticated fallback: Track API, Rating API, Find a Post Office API.
CANADA_POST_API_KEY=
CANADA_POST_API_PASSWORD=

# MyMail is OPT-IN and LOCAL ONLY. It never logs in during this run.
# Set CANADA_POST_MyMAIL_ENABLED=true only on your own machine, with your own
# account, and only after you understand the break risk in the README.
# CANADA_POST_MyMAIL_ENABLED=false
# Mock mode (no login, sample data, for tests): CANADA_POST_MyMAIL_MOCK=true
# CANADA_POST_MyMAIL_MOCK=false
# Optional: path to a MyMail export file YOU saved locally from the Canada Post app.
# CANADA_POST_MyMAIL_EXPORT_FILE=
